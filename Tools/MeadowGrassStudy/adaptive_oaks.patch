+void loadSprayFamilies(ViewerScene& scene, const std::filesystem::path& manifest)
+{
+    auto hierarchy = std::make_shared<TreeHierarchy>();
+    std::vector<bool> registered(scene.asset->meshes.size());
+    std::ifstream input(manifest);
+    for (std::string line; std::getline(input, line);)
+    {
+        std::istringstream fields(line);
+        std::string leaf, wood, tree, extra;
+        if (!(fields >> leaf >> wood >> tree) || fields >> extra)
+            throw std::runtime_error("Invalid spray family manifest.");
+        const auto local = [&](const std::filesystem::path& name) {
+            if (name != name.filename()) throw std::runtime_error("Expected a local bake filename.");
+            return manifest.parent_path() / name;
+        };
+        const SprayBoughSources sources{scene.source, local(leaf), local(wood)};
+        auto& pair = scene.sprayFamilies.emplace_back();
+        for (std::size_t i = 0; i < pair.size(); ++i)
+            pair[i] = std::make_shared<FixedLod>(readFixedLod(scene.source, sources[i + 1], *scene.asset));
+        const auto a = pair[0]->meshIndex, b = pair[1]->meshIndex;
+        if (!scene.isLeafSpray(a) || scene.isLeafSpray(b) || registered[a] || registered[b] ||
+            scene.asset->meshes[a].instances != scene.asset->meshes[b].instances)
+            throw std::runtime_error("Incompatible shoot material roles or placement streams.");
+        auto group = readTreeHierarchy(sources, *scene.asset, local(tree));
+        for (auto& part : group.parts)
+        {
+            const auto id = part.meshIndex;
+            if (scene.asset->meshes[id].instances)
+            {
+                if (id != a && id != b) throw std::runtime_error("Unexpected shoot hierarchy part.");
+                if (part.placementOrder.empty()) part.placementOrder = group.placementOrder;
+            }
+            else if (registered[id]) continue; // Legacy per-pair bakes include the same scaffold.
+            registered[id] = true;
+            hierarchy->parts.push_back(std::move(part));
+        }
+    }
+    if (scene.sprayFamilies.empty() || std::ranges::find(registered, false) != registered.end())
+        throw std::runtime_error("Incomplete spray family manifest.");
+    scene.sprayLods = scene.sprayFamilies.front();
+    scene.treeHierarchy = hierarchy;
+    scene.branchLod = automaticBranchLod;
+    scene.sprayTraversal = SprayTraversal::Hierarchy;
+}
+
+// Validate against the original tree before combining its draw parts with the meadow.
+void attachMeadowOak(ViewerScene& scene)
+{
+    ViewerScene oak{};
+    oak.source = scene.source.parent_path() / "oak" / scene.source.filename();
+    oak.asset = std::make_shared<AssetData>(loadGlb(oak.source));
+    auto manifest = oak.source;
+    loadSprayFamilies(oak, manifest.replace_extension(".spraylods"));
+    auto meadow = std::move(scene.asset->meshes);
+    auto& parts = scene.asset->meshes;
+    parts = std::move(oak.asset->meshes);
+    scene.oakPartCount = parts.size();
+    // Keep the old geometry only for lighting probes. Discover roots from one
+    // part and match all other parts by transform, independent of GLB node order.
+    const auto& anchor = parts.at(0);
+    const auto inverseAnchor = XMMatrixInverse(nullptr, XMLoadFloat4x4(&anchor.localToWorld));
+    for (const auto& mesh : meadow)
+    {
+        if (mesh.name != anchor.name) continue;
+        XMFLOAT4X4 root;
+        XMStoreFloat4x4(&root, inverseAnchor * XMLoadFloat4x4(&mesh.localToWorld));
+        scene.oakPlacements.push_back({static_cast<unsigned>(scene.oakPlacements.size() + 1),
+            {root._41, root._43, std::atan2(root._31, root._11), root._22}, root._42});
+    }
+    if (scene.oakPlacements.empty()) throw std::runtime_error("Meadow contains no placements of the baked oak.");
+    std::vector<bool> registered(scene.oakPartCount * scene.oakPlacements.size());
+    std::vector<std::optional<std::size_t>> materials(scene.oakPartCount);
+    for (auto& mesh : meadow)
+    {
+        const auto oakEnd = parts.begin() + scene.oakPartCount;
+        const auto source = std::ranges::find(parts.begin(), oakEnd, mesh.name, &MeshData::name);
+        if (source == oakEnd)
+        {
+            parts.push_back(std::move(mesh));
+            continue;
+        }
+        const auto partIndex = static_cast<std::size_t>(source - parts.begin());
+        auto& material = materials[partIndex];
+        if (oak.asset->materials.at(source->material).name != scene.asset->materials.at(mesh.material).name ||
+            (material && *material != mesh.material))
+            throw std::runtime_error("Meadow oak material differs from the baked asset.");
+        material = mesh.material;
+        const auto actual = XMLoadFloat4x4(&mesh.localToWorld);
+        const auto placed = std::ranges::find_if(scene.oakPlacements, [&](const SceneObject& object) {
+            if (registered[(object.id - 1) * scene.oakPartCount + partIndex]) return false;
+            const auto expected = XMLoadFloat4x4(&source->localToWorld) * object.placementMatrix();
+            for (unsigned row = 0; row < 4; ++row)
+                if (!XMVector4NearEqual(expected.r[row], actual.r[row], XMVectorReplicate(0.0001f))) return false;
+            return true;
+        });
+        if (placed == scene.oakPlacements.end())
+            throw std::runtime_error("Meadow oak part has no matching upright tree placement.");
+        registered[(placed->id - 1) * scene.oakPartCount + partIndex] = true;
+        scene.oakProbeMeshes.push_back(std::move(mesh));
+    }
+    if (std::ranges::find(registered, false) != registered.end())
+        throw std::runtime_error("Incomplete meadow oak placement.");
+    for (std::size_t i = 0; i < scene.oakPartCount; ++i) parts[i].material = materials[i].value();
+    scene.meshShadows.assign(parts.size(), {});
+    scene.sprayFamilies = std::move(oak.sprayFamilies);
+    scene.sprayLods = oak.sprayLods;
+    scene.treeHierarchy = std::move(oak.treeHierarchy);
+    scene.branchLod = automaticBranchLod;
+    scene.sprayTraversal = SprayTraversal::Hierarchy;
+    scene.treeSubmission = TreeSubmission::GpuBatched;
+}
