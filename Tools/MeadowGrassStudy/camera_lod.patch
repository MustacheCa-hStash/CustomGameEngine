+// The authored tubes use contiguous rings. Preserve each ring centre, both ends
+// and every panicle branch. Skip alternate radial vertices only on wide rings.
+static std::vector<UINT> cameraTubeIndices(const MeshData& mesh, float& error)
+{
+    std::vector<UINT> indices;
+    const auto& src = mesh.indices;
+    for (size_t cursor=0; cursor<src.size();)
+    {
+        if (cursor+6>src.size()) return {};
+        const UINT base=src[cursor], next=src[cursor+5];
+        const UINT sides=next-base;
+        if (next<=base || sides<3 || sides>12 || cursor+6*sides>src.size() ||
+            size_t(next)+sides>mesh.vertices.size()) return {};
+        for (UINT j=0;j<sides;++j)
+        {
+            const UINT k=(j+1)%sides;
+            const UINT face[]={base+j,base+k,next+k,base+j,next+k,next+j};
+            if (!std::equal(std::begin(face),std::end(face),src.begin()+cursor+6*j)) return {};
+        }
+        for (UINT j=0; j<sides;)
+        {
+            const UINT end=std::min(sides,j+(sides>=5 ? 2u : 1u)), k=end%sides;
+            indices.insert(indices.end(),{base+j,base+k,next+k,base+j,next+k,next+j});
+            if (end==j+2)
+                for (UINT ring : {base,next})
+                {
+                    const auto p=[&](UINT lane){ return XMLoadFloat3(&mesh.vertices[ring+lane].position); };
+                    error=std::max(error,XMVectorGetX(XMVector3Length(p(j+1)-XMVectorLerp(p(j),p(k),.5f))));
+                }
+            j=end;
+        }
+        cursor+=6*sides;
     }
     return indices;
 }
