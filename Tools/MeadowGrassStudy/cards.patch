+// Retain source order, including at equal depth. Coalesce consecutive visible
+// sprays or trunk index ranges into draws without changing the shadow list.
+template<class Draw>
+static void visibleOakRanges(const BoundingBox& envelope, const std::vector<BoundingBox>& boxes,
+                             const std::array<XMVECTOR,6>& planes, Draw draw)
+{
+    if (!intersectsFrustum(envelope,planes)) return;
+    const UINT size=static_cast<UINT>(boxes.size());
+    if (insideFrustum(envelope,planes)) { draw(0,size); return; }
+    UINT first=0,count=0;
+    for (UINT i=0;i<size;++i)
+    {
+        if (intersectsFrustum(boxes[i],planes))
+        {
+            if (!count) first=i;
+            ++count;
+        }
+        else if (count) { draw(first,count); count=0; }
+    }
+    if (count) draw(first,count);
+}
