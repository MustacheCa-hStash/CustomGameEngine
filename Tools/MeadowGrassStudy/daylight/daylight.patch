+        float wind = saturate((center.y-windStart)*inverseWindHeight);
+        float2 rest = cell.xz - proxyWind * (wind*wind/proxyOriginCellSize.w);
+        // Sample area-weighted leaf color and orientation across the same wind footprint as extinction.
+        int2 corner = int2(floor(rest));
+        float2 f = frac(rest);
+        uint4 local = oakMaterial[index];
+        float3 leafResponse = leafReflectance(local);
+        if (any(proxyWind != 0) && leafArea > 0)
+        {
+            leafResponse = 0;
+            float sum = 0;
+            [unroll] for (int i=0;i<4;++i)
+            {
+                int2 offset = int2(i&1,i>>1);
+                int2 p = corner+offset;
+                if (any(p<0) || any(p>=int2(proxySize.xz))) continue;
+                uint neighbor = densityIndex(uint3(p.x,cell.y,p.y));
+                float2 w = lerp(1-f,f,float2(offset));
+                float area = w.x*w.y*length(restDensity[neighbor].xyz);
+                sum += area;
+                leafResponse += area * leafReflectance(oakMaterial[neighbor]);
+            }
+            leafResponse /= max(sum,1e-8);
+        }
+        float4 bark = unpackRGBA(local.y);
+        float3 woodResponse = bark.rgb*bark.rgb*bark.a * meanCosine(2*unpackRGBA(local.w).rgb-1,false);
+        float3 response = (leafArea*leafResponse + density.w*woodResponse)/total;
+        if (any(response > 0))
+        {
+            float limit = length(float3(proxySize.xyz))*proxyOriginCellSize.w;
+            float visibility = traceVisibility(center + .32*proxyOriginCellSize.w*toSun,toSun,limit);
+            outgoing = response * (sunStrength*visibility);
+        }
+    }
+    oakLight[index] = float4(outgoing,0);
 }
 
