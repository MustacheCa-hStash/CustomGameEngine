+SkyIrradiance daylightIrradiance(SkyIrradiance base, XMFLOAT3 sun)
+{
+    constexpr unsigned width = 64, height = 32;
+    std::vector<XMFLOAT3> pixels(width * height);
+    for (unsigned row = 0; row < height / 2; ++row)
+    {
+        const float lat = float(pi * (0.5 - (row + 0.5) / height));
+        for (unsigned col = 0; col < width; ++col)
+        {
+            const float lon = float(pi * (2 * (col + 0.5) / width - 1));
+            const float cosine = std::cos(lat) * (std::sin(lon)*sun.x + std::cos(lon)*sun.z) + std::sin(lat)*sun.y;
+            const float h = circumsolarRadiance(cosine);
+            pixels[row*width+col] = {h*hazeRed, h*hazeGreen, h*hazeBlue};
+        }
+    }
+    float unused = 1;
+    const auto haze = projectIrradiance(pixels, width, height, unused, false);
+    for (unsigned i = 0; i < base.size(); ++i)
+        XMStoreFloat4(&base[i], XMLoadFloat4(&base[i]) + XMLoadFloat4(&haze[i]));
+    return base;
 }
 
