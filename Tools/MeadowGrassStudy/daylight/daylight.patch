+
+// Average outward cosine for a distribution of normals within a proxy voxel.
+// Leaves return direct diffuse energy into two hemispheres; bark has one front face.
+float meanCosine(float3 average, bool leaf)
+{
+    float coherence = length(average);
+    float cosine = dot(average,toSun) / max(coherence,1e-5);
+    return lerp(.25,leaf ? .5*abs(cosine) : saturate(cosine),saturate(coherence));
+}
+
+float3 leafReflectance(uint4 material)
+{
+    const float4 leaf = unpackRGBA(material.x);
+    return leaf.rgb*leaf.rgb*leaf.a * meanCosine(2*unpackRGBA(material.z).rgb-1,true);
+}
