+// Each optimized lamina has eight folded rows (margin, keel, margin) and a tip.
+// Retain every blade and choose the interior rows with the largest silhouette errors.
+static std::vector<UINT> farBladeIndices(const MeshData& mesh, float& error)
+{
+    constexpr UINT stride = 25;
+    if (mesh.vertices.size()%stride || mesh.indices.size()!=mesh.vertices.size()/stride*90) return {};
+    std::vector<UINT> templateIndices;
+    for (UINT row=0; row<8; ++row)
+        for (UINT k=0; k<2; ++k)
+        {
+            const UINT a=row*3+k, b=std::min(24u,a+3), c=std::min(24u,a+4);
+            if (b!=c) templateIndices.insert(templateIndices.end(),{a,b,c});
+            templateIndices.insert(templateIndices.end(),{a,c,a+1});
+        }
+    for (size_t i=0; i<mesh.indices.size(); ++i)
+        if (mesh.indices[i] != (i/90)*stride+templateIndices[i%90]) return {};
+    std::vector<UINT> indices;
+    for (UINT base=0; base<mesh.vertices.size(); base+=stride)
+    {
+        const auto id = [&](UINT row, UINT lane) { return base+std::min(24u,row*3+lane); };
+        const auto point = [&](UINT row, UINT lane) { return XMLoadFloat3(&mesh.vertices[id(row,lane)].position); };
+        std::vector<UINT> cuts{0,8};
+        for (;;)
+        {
+            float worst=-1;
+            UINT split=0;
+            for (size_t j=1; j<cuts.size(); ++j)
+            {
+                const UINT a=cuts[j-1], b=cuts[j];
+                const auto chord=point(b,1)-point(a,1);
+                const float length2=std::max(1e-12f,XMVectorGetX(XMVector3LengthSq(chord)));
+                for (UINT row=a+1; row<b; ++row)
+                {
+                    const float t=std::clamp(XMVectorGetX(XMVector3Dot(point(row,1)-point(a,1),chord))/length2,0.f,1.f);
+                    for (UINT lane=0; lane<3; ++lane)
+                    {
+                        const auto delta=point(row,lane)-XMVectorLerp(point(a,lane),point(b,lane),t);
+                        const float d=XMVectorGetX(XMVector3Length(delta));
+                        if (d>worst) { worst=d; split=row; }
+                    }
+                }
+            }
+            if (cuts.size()>=5) { error=std::max(error,worst); break; }
+            cuts.insert(std::lower_bound(cuts.begin(),cuts.end(),split),split);
+        }
+        for (size_t j=1; j<cuts.size(); ++j)
+        {
+            const UINT a=cuts[j-1],b=cuts[j];
+            for (UINT k=0;k<2;++k)
+            {
+                if (b<8) indices.insert(indices.end(),{id(a,k),id(b,k),id(b,k+1)});
+                indices.insert(indices.end(),{id(a,k),id(b,k+1),id(a,k+1)});
+            }
+        }
+    }
+    return indices;
+}
