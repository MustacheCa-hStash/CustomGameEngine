+float3 bladeShadingNormal(float3 position, float3 n, float2 uv)
+{
+    float3 dx = ddx(position), dy = ddy(position);
+    float2 du = ddx(uv), dv = ddy(uv);
+    float det = du.x * dv.y - du.y * dv.x;
+    float3 t = (dx * dv.y - dy * du.y) * sign(det);
+    t -= n * dot(n, t);
+    if (dot(t,t) < 1e-26 || abs(det) < 1e-18) return n;
+    t = normalize(t);
+    float3 b = cross(n,t);
+    b *= sign(dot(b, (dy * du.x - dx * dv.x) * sign(det)));
+    float3 map = 2.0 * detailTexture.SampleGrad(colorSampler, uv, du, dv).xyz - 1.0;
+    return normalize(t * map.x * bladeNormalScale + b * map.y * bladeNormalScale + n * map.z);
+}
+
+float bladeSunReflection(float3 n, float3 v, float roughness)
+{
+    float nl = saturate(dot(n,toSun)), nv = saturate(dot(n,v));
+    if (min(nl,nv) <= 0.0) return 0.0;
+    float3 h = normalize(toSun + v);
+    float nh = saturate(dot(n,h)), vh = saturate(dot(v,h));
+    float a2 = max(pow(roughness, 4.0), 1e-4);
+    float d = 1.0 + nh*nh*(a2-1.0);
+    float smith = 0.5 / max(nl*sqrt(a2+(1-a2)*nv*nv) + nv*sqrt(a2+(1-a2)*nl*nl), 1e-5);
+    // Dielectric cuticle with the Blender material's IOR of 1.42.
+    float fresnel = 0.0301 + 0.9699*pow(1.0-vh,5.0);
+    return 0.65 * nl * (a2/(d*d)) * smith * fresnel;
+}
